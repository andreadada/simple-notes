POSTGRES_DB=simplenotes
POSTGRES_USER=simplenotes
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET
# Comma-separated Google OAuth client IDs for Android/Windows.
GOOGLE_CLIENT_IDS=YOUR_ANDROID_ID.apps.googleusercontent.com,YOUR_WINDOWS_ID.apps.googleusercontent.com
# Base64 of 32+ randomly generated bytes; e.g. openssl rand -base64 32
APP_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_SECRET
